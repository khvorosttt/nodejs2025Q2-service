// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url  	    = env("DATABASE_URL")
}

model User {
  id    String     @id @default(uuid()) @unique
  login String
  password String
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Artist {
  id    String     @id @default(uuid()) @unique
  name String
  grammy Boolean @default(false)
  tracks Track[]
  albums Album[]
  isFavorite Boolean @default(false)
}

model Track {
  id    String     @id @default(uuid()) @unique
  name String
  artist Artist?   @relation(references: [id], fields: [artistId], onDelete: SetNull)
  artistId String?
  album Album?   @relation(references: [id], fields: [albumId], onDelete: SetNull)
  albumId String?
  duration Int
  isFavorite Boolean @default(false)
}

model Album {
  id    String     @id @default(uuid()) @unique
  name String
  year Int
  artist Artist?   @relation(references: [id], fields: [artistId], onDelete: SetNull)
  artistId String?
  tracks Track[]
  isFavorite Boolean @default(false)
}